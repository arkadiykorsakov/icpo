// ============================================================
// ENUMS
// ============================================================

Enum criminal_status {
  wanted
  serving
  retired
  deceased
  detained
  acquitted
}

Enum language_level {
  A1
  A2
  B1
  B2
  C1
  C2
  Native
}

Enum gender {
    male
    female
}

// ============================================================
// АУТЕНТИФИКАЦИЯ
// ============================================================

Table users {
  id                BIGSERIAL    [pk]
  name              VARCHAR(255) [not null]
  email             VARCHAR(255) [not null, unique]
  email_verified_at TIMESTAMPTZ
  password          VARCHAR(255) [not null]
  remember_token    VARCHAR(100)
  created_at        TIMESTAMPTZ  [not null, default: `NOW()`]
  updated_at        TIMESTAMPTZ  [not null, default: `NOW()`]
}

Table password_reset_tokens {
  email      VARCHAR(255) [pk]
  token      VARCHAR(255) [not null]
  created_at TIMESTAMPTZ
}

Table sessions {
  id            VARCHAR(255) [pk]
  user_id       BIGINT
  ip_address    VARCHAR(45)
  user_agent    TEXT
  payload       TEXT [not null]
  last_activity INTEGER [not null]

  indexes {
    user_id
    last_activity
  }
}

// ============================================================
// СПРАВОЧНИКИ
// ============================================================

Table countries {
  id         BIGSERIAL    [pk]
  name       VARCHAR(255) [not null]
  iso2       VARCHAR(2)   [not null, unique]
  iso3       VARCHAR(3)   [not null, unique]
  created_at TIMESTAMPTZ  [not null, default: `NOW()`]

  indexes {
    `lower(name)` [unique, name: 'countries_lower_name_ux']
  }
}

Table cities {
  id         BIGSERIAL    [pk]
  name       VARCHAR(255) [not null]
  country_id BIGINT       [not null, ref: > countries.id]
  created_at TIMESTAMPTZ  [not null, default: `NOW()`]

  indexes {
    (country_id, `lower(name)`) [unique, name: 'cities_lower_name_country_id_ux']
  }

  Note: '''
  FK country_id: ON DELETE RESTRICT.
  '''
}

Table languages {
  id         BIGSERIAL    [pk]
  name       VARCHAR(255) [not null]
  code       VARCHAR(35)  [not null]
  created_at TIMESTAMPTZ  [not null, default: `NOW()`]

  indexes {
    `lower(name)` [unique, name: 'languages_lower_name_ux']
    `lower(code)` [unique, name: 'languages_lower_code_ux']
  }

  Note: '''
  code:
    Уникальный код языка по стандарту BCP 47.
    Примеры: en, ru, en-US, pt-BR.
    Хранение в каноническом регистре BCP 47.
  '''
}

Table offense_categories {
  id          BIGSERIAL    [pk]
  name        VARCHAR(255) [not null]
  description TEXT
  created_at  TIMESTAMPTZ  [not null, default: `NOW()`]

  indexes {
    `lower(name)` [unique, name: 'offense_categories_lower_name_ux']
  }
}

Table hair_colors {
  id         BIGSERIAL    [pk]
  name       VARCHAR(255) [not null]
  created_at TIMESTAMPTZ  [not null, default: `NOW()`]

  indexes {
    `lower(name)` [unique, name: 'hair_colors_lower_name_ux']
  }
}

Table eye_colors {
  id         BIGSERIAL    [pk]
  name       VARCHAR(255) [not null]
  created_at TIMESTAMPTZ  [not null, default: `NOW()`]

  indexes {
    `lower(name)` [unique, name: 'eye_colors_lower_name_ux']
  }
}

// ============================================================
// ПРЕСТУПНИКИ
// ============================================================

Table criminals {
  id                  BIGSERIAL    [pk]
  last_name           VARCHAR(255) [not null]
  first_name          VARCHAR(255) [not null]
  middle_name         VARCHAR(255)
  nickname            VARCHAR(255)

  gender              gender        [not null, default: 'male']

  height_cm           INT
  weight_kg           NUMERIC(4,1)

  has_head_hair       BOOLEAN      [not null, default: true]
  hair_color_id       BIGINT       [ref: >? hair_colors.id]
  eye_color_id        BIGINT       [ref: >? eye_colors.id]

  birth_date          DATE
  birth_city_id       BIGINT       [ref: >? cities.id]

  notes               TEXT

  created_at          TIMESTAMPTZ  [not null, default: `NOW()`]
  updated_at          TIMESTAMPTZ  [not null, default: `NOW()`]

  indexes {
    (last_name, first_name) [name: 'criminals_last_first_name_idx']
    birth_date              [name: 'criminals_birth_date_idx']
    birth_city_id           [name: 'criminals_birth_city_id_idx']
    hair_color_id           [name: 'criminals_hair_color_id_idx']
    eye_color_id            [name: 'criminals_eye_color_id_idx']

    `last_name || ' ' || first_name || COALESCE(' ' || middle_name, '') || COALESCE(' ' || nickname, '')` [
      name: 'criminals_search_trgm_idx',
      type: gin,
      note: 'pg_trgm, gin_trgm_ops: поиск ILIKE по ФИО и кличке'
    ]
  }

  checks {
    `birth_date IS NULL OR birth_date <= CURRENT_DATE`   [name: 'criminals_birth_date_check']

    `height_cm IS NULL OR height_cm BETWEEN 30 AND 280`  [name: 'criminals_height_cm_check']
    `weight_kg IS NULL OR weight_kg BETWEEN 0.5 AND 500` [name: 'criminals_weight_kg_check']

    `has_head_hair OR hair_color_id IS NULL`             [name: 'criminals_head_hair_check']
  }

  Note: '''
  Семантика волос:

  has_head_hair = FALSE AND hair_color_id IS NULL:
    Волосы на голове отсутствуют.

  has_head_hair = TRUE AND hair_color_id IS NULL:
    Волосы есть, цвет неизвестен.

  has_head_hair = TRUE AND hair_color_id IS NOT NULL:
    Волосы есть, цвет известен.

  FK hair_color_id: ON DELETE RESTRICT.
  FK eye_color_id: ON DELETE RESTRICT.
  FK birth_city_id: ON DELETE RESTRICT.
  '''
}

// ============================================================
// СВЯЗИ M:N
// ============================================================

Table criminal_sightings {
  id                BIGSERIAL    [pk]
  criminal_id       BIGINT       [not null, ref: > criminals.id]
  city_id           BIGINT       [not null, ref: > cities.id]
  description       TEXT
  effective_date    DATE         [not null]
  effective_time    TIME
  created_at        TIMESTAMPTZ  [not null, default: `NOW()`]
  updated_at        TIMESTAMPTZ  [not null, default: `NOW()`]

  indexes {
    city_id                         [name: 'criminal_sightings_city_id_idx']
    (criminal_id, effective_date)   [name: 'criminal_sightings_criminal_id_effective_date_idx']
  }

  checks {
    `effective_date <= CURRENT_DATE` [name: 'criminal_sightings_effective_date_check']
  }
}

Table spoken_languages {
  id           BIGSERIAL      [pk]
  criminal_id  BIGINT         [not null, ref: > criminals.id]
  language_id  BIGINT         [not null, ref: > languages.id]
  level        language_level
  created_at   TIMESTAMPTZ    [not null, default: `NOW()`]
  updated_at   TIMESTAMPTZ    [not null, default: `NOW()`]

  indexes {
    (criminal_id, language_id) [unique, name: 'spoken_languages_criminal_language_ux']
    language_id
  }

  Note: '''
  Таблица хранит языки, которыми владеет человек.

  level:
    Уровень владения языком.
    NULL означает, что уровень владения неизвестен.

  FK criminal_id: ON DELETE CASCADE.
  FK language_id: ON DELETE RESTRICT.
  '''
}

Table citizenships {
  id          BIGSERIAL    [pk]
  criminal_id BIGINT       [not null, ref: > criminals.id]
  country_id  BIGINT       [not null, ref: > countries.id]
  created_at  TIMESTAMPTZ  [not null, default: `NOW()`]

  indexes {
    (criminal_id, country_id) [unique, name: 'citizenships_criminal_country_ux']
    country_id
  }

  Note: '''
  Таблица хранит гражданство человека.
  Один человек может иметь гражданство нескольких стран.

  FK criminal_id: ON DELETE CASCADE.
  FK country_id:  ON DELETE RESTRICT.
  '''
}

Table criminal_offenses {
  criminal_id        BIGINT       [not null, ref: > criminals.id]
  offense_category_id BIGINT      [not null, ref: > offense_categories.id]
  created_at         TIMESTAMPTZ  [not null, default: `NOW()`]

  indexes {
    (criminal_id, offense_category_id) [pk]
    offense_category_id
  }

  Note: '''
  Таблица связывает людей с категориями преступлений.

  FK criminal_id: ON DELETE CASCADE.
  FK offense_category_id: ON DELETE RESTRICT.
  '''
}

// ============================================================
// ИСТОРИЯ СТАТУСОВ
// ============================================================

Table criminal_status_history {
  id           BIGSERIAL       [pk]
  criminal_id  BIGINT          [not null, ref: > criminals.id]
  status       criminal_status [not null]

  effective_at TIMESTAMPTZ     [not null]
  description  TEXT

  created_at   TIMESTAMPTZ     [not null, default: `NOW()`]
  updated_at   TIMESTAMPTZ     [not null, default: `NOW()`]

  indexes {
    (criminal_id, effective_at)
    status
  }

  checks {
    `effective_at <= created_at`
  }

  Note: '''
  Таблица хранит историю изменения статусов человека.

  effective_at:
    Фактическая дата и время изменения статуса.
    Должна быть позже effective_at предыдущего статуса этого человека.
    Не может быть в будущем.

  description:
    Причина изменения статуса или дополнительные сведения.
    Может быть NULL.

  Валидация хронологии:
    При добавлении нового статуса effective_at должен быть
    больше максимального effective_at существующих записей
    этого человека.

    При редактировании effective_at должен оставаться
    между датами предыдущего и следующего статусов.

  FK criminal_id: ON DELETE CASCADE.
  '''
}
